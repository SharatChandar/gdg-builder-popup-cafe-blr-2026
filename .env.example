PORT=8080
DEMO_MODE=true
CURRENCY=inr
# Use a long random secret and individual staff credentials in all deployed environments.
SESSION_SECRET=
STAFF_PIN=
# Production: JSON array of {username,role,active,passwordHash}; use Secret Manager.
STAFF_ACCOUNTS_JSON=
PUBLIC_URL=http://localhost:8080
# pglite for local PostgreSQL; postgres for Cloud SQL.
DATA_STORE=pglite
CAFE_ID=common-ground
WIFI_SSID=
WIFI_PASSWORD=
# Required for live online payments, along with DEMO_MODE=false and HTTPS PUBLIC_URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required to send actual SMS payment invitations in live mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Cloud SQL PostgreSQL (production). Local development defaults to embedded PostgreSQL.
# Cloud Run connects through its mounted Cloud SQL Unix socket.
INSTANCE_CONNECTION_NAME=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cafe
DB_USER=cafe
DB_PASSWORD=
# Optional direct PostgreSQL connection URL; do not commit credentials.
DATABASE_URL=
DB_SSL=false

# Gemini key remains server-side. No AI upload happens until Ask Gemini is pressed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Firebase web config is public. Enable Phone auth + authorized domains in Firebase.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Firebase Admin uses Application Default Credentials (Cloud Run service identity).
